<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Ustin.Work.LessMess.UmbarcoWrapper.Infrastructure.Repository</RootNamespace>
    <AssemblyName>Ustin.Work.LessMess.UmbarcoWrapper.Infrastructure.Repository</AssemblyName>
  </PropertyGroup>

  <!--
    Database A — durable, exists unconditionally in every mode.
    Today: the audit / event log. Later: device data, licences, terms acceptance.
    Own DbContext, own migrations history, own connection string (ConnectionStrings:WrapperDb).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ustin.Work.LessMess.UmbarcoWrapper.Core\Ustin.Work.LessMess.UmbarcoWrapper.Core.csproj" />
  </ItemGroup>

</Project>
