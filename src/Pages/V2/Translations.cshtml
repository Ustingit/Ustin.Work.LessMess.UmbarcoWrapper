@page
@model Ustin.Work.LessMess.UmbarcoWrapper.Web.Pages.V2.TranslationsModel
@{
    ViewData["Title"] = "Translations (v2)";
    ViewData["SignedInUser"] = Model.Username;
    ViewData["LogoutPage"] = "/V2/Logout";
}
<h1>Translations <span class="variant">v2 · Management API (back-office session)</span></h1>
<p class="count">
    @Model.Data!.Count entries · languages: @string.Join(", ", Model.Data.Languages)
    · source: <code>GET /umbraco/management/api/v1/dictionary</code>
</p>

<table>
    <thead>
        <tr>
            <th>Group</th>
            <th>Key</th>
            @foreach (var lang in Model.Data.Languages)
            {
                <th>@lang</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Data.Items)
        {
            <tr class="@(item.Values.Count == 0 ? "group-head" : null)">
                <td>@(item.Group ?? "—")</td>
                <td class="key">@item.Key</td>
                @foreach (var lang in Model.Data.Languages)
                {
                    <td>@(item.Values.TryGetValue(lang, out var value) ? value : "—")</td>
                }
            </tr>
        }
    </tbody>
</table>
