@page
@model Ustin.Work.LessMess.UmbarcoWrapper.Web.Pages.V2.LoginModel
@{
    ViewData["Title"] = "Sign in (v2 · back-office session)";
}
<div class="card">
    <h1>Sign in <span class="variant">v2 · back-office session</span></h1>
    <p class="alt">
        Authenticates a <strong>back-office user</strong> against Umbraco's stock OpenIddict
        server (PKCE). Modern Umbraco keeps the JWT server-side (BFF pattern), so the
        wrapper stores the returned <strong>HttpOnly cookie set</strong> and replays it on
        the Management API.
    </p>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="msg ok">@Model.Message</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="msg error">@Model.Error</div>
    }

    <form method="post">
        <label for="username">Username</label>
        <input type="text" id="username" name="Input.Username" value="@Model.Input.Username" autocomplete="username" required />

        <label for="password">Password</label>
        <input type="password" id="password" name="Input.Password" autocomplete="current-password" required />

        <button type="submit" class="primary">Sign in</button>
    </form>

    <p class="alt">Compare with <a asp-page="/Login">v1 (member cookie proxy)</a>.</p>
</div>
