@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="card">
    <h1>Sign in</h1>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="msg ok">@Model.Message</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="msg error">@Model.Error</div>
    }

    <form method="post">
        <label for="username">Username</label>
        <input type="text" id="username" name="Input.Username" value="@Model.Input.Username" autocomplete="username" required />

        <label for="password">Password</label>
        <input type="password" id="password" name="Input.Password" autocomplete="current-password" required />

        <button type="submit" class="primary">Sign in</button>
    </form>

    <p class="alt">No account yet? <a asp-page="/Register">Create one</a>.</p>
    <p class="alt">Or try <a asp-page="/V2/Login">v2 · back-office JWT</a>.</p>
</div>
