<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ustin.Work.LessMess.UmbarcoWrapper.Cms</RootNamespace>

    <!-- Razor runtime compilation keeps the container image simple: no design-time views to precompile. -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
    <GenerateRazorAssemblyInfo>false</GenerateRazorAssemblyInfo>

    <!-- Umbraco ships analyzers that treat some template patterns as warnings; don't fail CI on them. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="17.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't copy the local SQLite db / logs into the build output. -->
    <Content Remove="umbraco\**" />
    <None Include="umbraco\**" />
  </ItemGroup>

</Project>
